table 'dw dim_date'
	lineageTag: 7f2f4062-19eb-4054-9528-414fd3ffe79f

	measure 'vs last year' = ```
			
			VAR SelectedYear =
			    SELECTEDVALUE('dw dim_date'[year])
			
			VAR CurrentYearCount =
			    [DisasterRecord]
			
			VAR PreviousYearCount =
			    CALCULATE(
			        [DisasterRecord],
			        REMOVEFILTERS('dw dim_date'),
			        'dw dim_date'[year] = SelectedYear - 1
			    )
			
			VAR Difference =
			    CurrentYearCount - PreviousYearCount
			
			VAR _format = 
			SWITCH(
			    TRUE(),
			    Difference > 0, UNICHAR(11165) & " " & FORMAT(Difference, "#,##0"),
			    Difference < 0, UNICHAR(11167) & " " & FORMAT(Difference, "#,##0"),
			    FORMAT(Difference, "#,##0")
			)
			
			RETURN
			    IF(
			        ISBLANK(SelectedYear),
			        BLANK(),
			        _format
			    )
			```
		lineageTag: b57b61f0-cb2e-43ae-b1cf-b52972ffef95

		changedProperty = IsHidden

	measure 'Previous Year' =
			
			VAR SelectedYear =
			    SELECTEDVALUE('dw dim_date'[year])
			RETURN
			    IF(
			        NOT ISBLANK(SelectedYear),
			        SelectedYear - 1
			    )
		formatString: 0
		lineageTag: 610fb663-a947-4a81-b4eb-ca062b8dd1e8

		changedProperty = IsHidden

	measure ColorFormatPYDisaster = ```
			
			VAR SelectedYear =
			    SELECTEDVALUE('dw dim_date'[year])
			
			VAR CurrentYearCount =
			    [DisasterRecord]
			
			VAR PreviousYearCount =
			    CALCULATE(
			        [DisasterRecord],
			        REMOVEFILTERS('dw dim_date'),
			        'dw dim_date'[year] = SelectedYear - 1
			    )
			
			VAR Difference =
			    CurrentYearCount - PreviousYearCount
			
			VAR _format = SWITCH(
			    TRUE(),
			    Difference > 0, "Red",
			    Difference < 0, "Green",
			    "Grey"
			)
			RETURN _format
			
			
			
			
			
			
			```
		lineageTag: e54ebdee-6da7-41da-be48-5e5049f2ec85

		changedProperty = IsHidden

	measure DisasterCountPeriodLabel = ```
			
			VAR _fromDate = MIN('dw dim_date'[full_date])
			VAR _toDate = MAX('dw dim_date'[full_date])
			
			RETURN
			
			 FORMAT(_fromDate, "dd MMM YYYY") & " - " & FORMAT(_toDate, "dd MMM YYYY")
			
			
			
			
			
			
			```
		lineageTag: be7d9119-cfc0-4a40-a43a-7f1f95a925a5

		changedProperty = IsHidden

