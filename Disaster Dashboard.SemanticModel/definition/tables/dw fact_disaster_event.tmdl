	measure 'Average Duration YTD' = VAR _last = MAXX(LASTNONBLANK('dw dim_date'[full_date], [DisasterRecord]), 'dw dim_date'[full_date]) RETURN CALCULATE(AVERAGE('dw fact_disaster_event'[duration_days]), FILTER(ALL('dw dim_date'), 'dw dim_date'[full_date] >= DATE(YEAR(_last),1,1) && 'dw dim_date'[full_date] <= _last))
		formatString: 0.0
		lineageTag: b467d360-3c06-4629-a97e-5207d443a762

	measure 'Average Duration PY YTD' = VAR _last = MAXX(LASTNONBLANK('dw dim_date'[full_date], [DisasterRecord]), 'dw dim_date'[full_date]) RETURN CALCULATE(AVERAGE('dw fact_disaster_event'[duration_days]), FILTER(ALL('dw dim_date'), 'dw dim_date'[full_date] >= DATE(YEAR(_last)-1,1,1) && 'dw dim_date'[full_date] <= EDATE(_last,-12)))
		formatString: 0.0
		lineageTag: ab98c626-cc76-4b32-81e7-c11be9d62bc2

	measure 'Average Duration YoY %' = DIVIDE([Average Duration YTD] - [Average Duration PY YTD], [Average Duration PY YTD])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: bad40458-b57f-4d96-a791-a6a451a29c9e

	/// Distinct disaster events (multi-country events counted once)
	measure 'Total Events' = [DisasterRecord]
		formatString: #,0
		displayFolder: KPI\01 Overview
		lineageTag: 69f1083f-f14d-42cd-9d40-c91b0f81fef2

	/// Number of countries/locations with at least one event in the current filter context
	measure 'Countries Affected' = DISTINCTCOUNT('dw fact_disaster_event'[location_id])
		formatString: #,0
		displayFolder: KPI\01 Overview
		lineageTag: b1e6239f-2901-448c-aa2f-c7f9a79d2a67

	/// Average events per year, over years that had events
	measure 'Avg Events per Year' = AVERAGEX(VALUES('dw dim_date'[year]), [DisasterRecord])
		formatString: #,0.0
		displayFolder: KPI\01 Overview
		lineageTag: dbcdc2e9-db82-4e4e-8eac-f130f68f9a79

	/// Events with GDACS Red alert (likely need international assistance)
	measure 'Red Alert Events' = CALCULATE([DisasterRecord], 'dw dim_alert'[alert_level] = "Red")
		formatString: #,0
		displayFolder: KPI\02 Alerts & Risk
		lineageTag: 2802eacc-e137-4ee2-8818-f277c9d2ecfd

	/// Events with GDACS Orange alert
	measure 'Orange Alert Events' = CALCULATE([DisasterRecord], 'dw dim_alert'[alert_level] = "Orange")
		formatString: #,0
		displayFolder: KPI\02 Alerts & Risk
		lineageTag: 4a918b54-ef9b-4519-a200-652aec539a76

	/// Events with GDACS Red or Orange alert
	measure 'High Alert Events' = CALCULATE([DisasterRecord], 'dw dim_alert'[alert_level] IN {"Red", "Orange"})
		formatString: #,0
		displayFolder: KPI\02 Alerts & Risk
		lineageTag: 1e7dac4c-c53b-43d3-9f02-d3a83d4b386a

	/// Share of events that reached Orange or Red alert
	measure 'High Alert Rate %' = DIVIDE([High Alert Events], [DisasterRecord])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: KPI\02 Alerts & Risk
		lineageTag: 8652134d-82af-423e-a0cf-dbb6696e1305

	measure 'High Alert Events YTD' = VAR _last = MAXX(LASTNONBLANK('dw dim_date'[full_date], [DisasterRecord]), 'dw dim_date'[full_date]) RETURN CALCULATE([High Alert Events], FILTER(ALL('dw dim_date'), 'dw dim_date'[full_date] >= DATE(YEAR(_last),1,1) && 'dw dim_date'[full_date] <= _last))
		formatString: #,0
		displayFolder: KPI\02 Alerts & Risk
		lineageTag: ea76b827-8d57-4f39-8da2-fe0d6a4ffad7

	measure 'High Alert Events PY YTD' = VAR _last = MAXX(LASTNONBLANK('dw dim_date'[full_date], [DisasterRecord]), 'dw dim_date'[full_date]) RETURN CALCULATE([High Alert Events], FILTER(ALL('dw dim_date'), 'dw dim_date'[full_date] >= DATE(YEAR(_last)-1,1,1) && 'dw dim_date'[full_date] <= EDATE(_last,-12)))
		formatString: #,0
		displayFolder: KPI\02 Alerts & Risk
		lineageTag: 50642062-b6ef-4643-b067-19458bf30c9e

	measure 'High Alert Events YoY %' = DIVIDE([High Alert Events YTD] - [High Alert Events PY YTD], [High Alert Events PY YTD])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: KPI\02 Alerts & Risk
		lineageTag: 5a3a1714-9501-4f62-8d35-4886b18987c2

	/// Alert-weighted risk index: Green x1 + Orange x3 + Red x9. Rewards severity, not just frequency.
	measure 'Risk Score' =
			VAR _green = CALCULATE([DisasterRecord], 'dw dim_alert'[alert_level] = "Green")
			RETURN _green * 1 + [Orange Alert Events] * 3 + [Red Alert Events] * 9
		formatString: #,0
		displayFolder: KPI\02 Alerts & Risk
		lineageTag: 2bad9953-883d-42bc-bb00-79172d3d391b

	/// Rank of the country by Risk Score within the current selection
	measure 'Country Risk Rank' = IF(HASONEVALUE('dw dim_location'[country_location_name]) && NOT ISBLANK([Risk Score]), RANKX(ALLSELECTED('dw dim_location'[country_location_name]), [Risk Score], , DESC, Dense))
		formatString: 0
		displayFolder: KPI\02 Alerts & Risk
		lineageTag: 7b27ceb3-4aaa-45d4-bd0a-fc5f7db6aaa3

	/// Days between the most recent Red alert event (in context) and the latest event date in the dataset
	measure 'Days Since Last Red Alert' =
			VAR _lastRed = CALCULATE(MAXX('dw fact_disaster_event', RELATED('dw dim_date'[full_date])), 'dw dim_alert'[alert_level] = "Red")
			VAR _dataEnd = CALCULATE(MAXX('dw fact_disaster_event', RELATED('dw dim_date'[full_date])), REMOVEFILTERS())
			RETURN IF(NOT ISBLANK(_lastRed), DATEDIFF(_lastRed, _dataEnd, DAY))
		formatString: #,0
		displayFolder: KPI\02 Alerts & Risk
		lineageTag: 9ac98774-92b9-4d9c-aca7-314e1fb25fe0

	/// Distinct flood events (by GDACS id, removes duplicate flood records)
	measure 'Flood Events' = COUNTROWS(FILTER(SUMMARIZE('dw fact_disaster_event', 'dw dim_flood'[gdacs_id]), NOT ISBLANK('dw dim_flood'[gdacs_id])))
		formatString: #,0
		displayFolder: KPI\03 Human Impact
		lineageTag: 87a2231e-8d01-4867-8cb1-35ef4e9259f3

	/// Flood deaths, each GDACS flood event counted once
	measure 'Flood Deaths' = SUMX(FILTER(SUMMARIZE('dw fact_disaster_event', 'dw dim_flood'[gdacs_id]), NOT ISBLANK('dw dim_flood'[gdacs_id])), CALCULATE(MAX('dw dim_flood'[death])))
		formatString: #,0
		displayFolder: KPI\03 Human Impact
		lineageTag: f551c2e2-756d-4310-bfe3-23478e6089cd

	/// People displaced by floods, each GDACS flood event counted once
	measure 'Flood Displaced' = SUMX(FILTER(SUMMARIZE('dw fact_disaster_event', 'dw dim_flood'[gdacs_id]), NOT ISBLANK('dw dim_flood'[gdacs_id])), CALCULATE(MAX('dw dim_flood'[displaced])))
		formatString: #,0
		displayFolder: KPI\03 Human Impact
		lineageTag: 7e061dab-ee59-4f33-ba18-394e02a2d631

	/// Average lethality of a flood event
	measure 'Deaths per Flood Event' = DIVIDE([Flood Deaths], [Flood Events])
		formatString: #,0.0
		displayFolder: KPI\03 Human Impact
		lineageTag: c5d614e7-1174-4083-86ff-2f9365c42b50

	/// Population exposed (EQ/VO/WF only; FL/TC/DR have no data). Multi-country events counted once.
	measure 'Population Exposed' = SUMX(VALUES('dw fact_disaster_event'[disaster_event_id]), CALCULATE(MAX('dw fact_disaster_event'[population_effected])))
		formatString: #,0
		displayFolder: KPI\03 Human Impact
		lineageTag: 00d31c38-6e54-4adb-a887-f06f9cc9a993

	measure 'Avg Earthquake Magnitude' = AVERAGEX(SUMMARIZE('dw fact_disaster_event', 'dw dim_earthquake'[disaster_event_id], 'dw dim_earthquake'[Magnitude]), 'dw dim_earthquake'[Magnitude])
		formatString: 0.0
		displayFolder: KPI\04 Hazard Severity
		lineageTag: 68870e54-2aa0-4c97-83e4-951556f678ce

	measure 'Max Earthquake Magnitude' = MAXX(SUMMARIZE('dw fact_disaster_event', 'dw dim_earthquake'[disaster_event_id], 'dw dim_earthquake'[Magnitude]), 'dw dim_earthquake'[Magnitude])
		formatString: 0.0
		displayFolder: KPI\04 Hazard Severity
		lineageTag: f086da7a-db99-43f7-8cc9-00fb4b8fa361

	/// Earthquakes of magnitude 6.0 or higher
	measure 'Strong Earthquakes (M6+)' = CALCULATE([Total Events], 'dw dim_earthquake'[Magnitude] >= 6)
		formatString: #,0
		displayFolder: KPI\04 Hazard Severity
		lineageTag: 2c23e1c0-e3cd-4d56-b5c0-8621947ef2ed

	measure 'Avg Cyclone Wind Speed (km/h)' = AVERAGEX(SUMMARIZE('dw fact_disaster_event', 'dw dim_tropical_cyclone'[disaster_event_id], 'dw dim_tropical_cyclone'[Max Wind Speed (km/h)]), 'dw dim_tropical_cyclone'[Max Wind Speed (km/h)])
		formatString: #,0
		displayFolder: KPI\04 Hazard Severity
		lineageTag: 9c2bdbd9-428e-48da-84c0-bccaf97cffed

	measure 'Max Cyclone Wind Speed (km/h)' = MAXX(SUMMARIZE('dw fact_disaster_event', 'dw dim_tropical_cyclone'[disaster_event_id], 'dw dim_tropical_cyclone'[Max Wind Speed (km/h)]), 'dw dim_tropical_cyclone'[Max Wind Speed (km/h)])
		formatString: #,0
		displayFolder: KPI\04 Hazard Severity
		lineageTag: 0f80c049-60cf-46bd-81e2-b3ee99618e4a

	/// Cyclones in category Extreme or Catastrophic
	measure 'Severe Cyclones' = CALCULATE([Total Events], 'dw dim_tropical_cyclone'[category] IN {"Extreme", "Catastrophic"})
		formatString: #,0
		displayFolder: KPI\04 Hazard Severity
		lineageTag: 9634ce7e-5dbb-4009-b8cb-5f37273f50e1

	measure 'Total Burned Area (ha)' = SUMX(SUMMARIZE('dw fact_disaster_event', 'dw dim_wild_fire'[disaster_event_id], 'dw dim_wild_fire'[Burned Area (ha)]), 'dw dim_wild_fire'[Burned Area (ha)])
		formatString: #,0
		displayFolder: KPI\04 Hazard Severity
		lineageTag: 429eef05-6697-4b6e-bf89-e2f728f73af8

	measure 'Drought Affected Area (km²)' = SUMX(SUMMARIZE('dw fact_disaster_event', 'dw dim_drought'[disaster_event_id], 'dw dim_drought'[effected_area_km2]), 'dw dim_drought'[effected_area_km2])
		formatString: #,0
		displayFolder: KPI\04 Hazard Severity
		lineageTag: b1413d92-6987-47b8-b818-a464e15155bd

	/// Average drought duration, each drought counted once
	measure 'Avg Drought Duration (days)' = CALCULATE(AVERAGEX(VALUES('dw fact_disaster_event'[disaster_event_id]), CALCULATE(MAX('dw fact_disaster_event'[duration_days]))), 'dw dim_event_type'[event_type] = "DR")
		formatString: #,0
		displayFolder: KPI\04 Hazard Severity
		lineageTag: 03232cc1-84fa-4b7c-b0ec-cfc04765122d

	/// Highest Volcanic Explosivity Index (0-8)
	measure 'Max Volcano VEI' = MAXX(SUMMARIZE('dw fact_disaster_event', 'dw dim_volcano'[disaster_event_id], 'dw dim_volcano'[VEI]), 'dw dim_volcano'[VEI])
		formatString: 0
		displayFolder: KPI\04 Hazard Severity
		lineageTag: 2331d355-f87b-414e-9f69-005078abde0e

	/// Share of events that have population data - shows how reliable Population Exposed is
	measure 'Population Data Coverage %' = DIVIDE(CALCULATE([DisasterRecord], NOT ISBLANK('dw fact_disaster_event'[population_effected])), [DisasterRecord])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: KPI\05 Data Quality
		lineageTag: 06041c63-da06-4d1b-8ed7-a5cabf176c4f

	/// Risk Score shown only for the top 10 countries in the current selection (for Top 10 charts)
	measure 'Risk Score (Top 10)' = IF([Country Risk Rank] <= 10, [Risk Score])
		formatString: #,0
		displayFolder: KPI\02 Alerts & Risk
		lineageTag: 8e2edd77-6b4f-47f2-8e88-36c23f046c58

	/// Average people displaced per flood event
	measure 'Displaced per Flood Event' = DIVIDE([Flood Displaced], [Flood Events])
		formatString: #,0
		displayFolder: KPI\03 Human Impact
		lineageTag: bc32c684-3cfd-47ae-93b2-ffa8a74efe50

	/// Deaths in the single deadliest flood event in context - shows how much one event drives the total
	measure 'Deadliest Flood (Deaths)' = MAXX(FILTER(SUMMARIZE('dw fact_disaster_event', 'dw dim_flood'[gdacs_id]), NOT ISBLANK('dw dim_flood'[gdacs_id])), CALCULATE(MAX('dw dim_flood'[death])))
		formatString: #,0
		displayFolder: KPI\03 Human Impact
		lineageTag: 799416d3-8143-4351-95a9-ce93b7e85727

	measure 'Flood Deaths Country Rank' = IF(HASONEVALUE('dw dim_location'[country_location_name]) && NOT ISBLANK([Flood Deaths]), RANKX(ALLSELECTED('dw dim_location'[country_location_name]), [Flood Deaths], , DESC, Dense))
		formatString: 0
		displayFolder: KPI\03 Human Impact
		lineageTag: 55bc6da8-dadb-41f1-b6d0-f71ad28bf0ff

	/// Flood deaths shown only for the top 10 countries (for Top 10 charts)
	measure 'Flood Deaths (Top 10 Countries)' = IF([Flood Deaths Country Rank] <= 10, [Flood Deaths])
		formatString: #,0
		displayFolder: KPI\03 Human Impact
		lineageTag: 6a277196-663c-4599-a2af-7debac9a2cfe

	measure 'Flood Event Rank' = IF(HASONEVALUE('dw dim_flood'[gdacs_id]) && NOT ISBLANK([Flood Deaths]), RANKX(ALLSELECTED('dw dim_flood'[gdacs_id]), [Flood Deaths], , DESC, Dense))
		formatString: 0
		displayFolder: KPI\03 Human Impact
		lineageTag: 61017711-6048-4d89-ac79-834dadae3a74

	/// Flood deaths shown only for the 10 deadliest flood events (for tables)
	measure 'Flood Deaths (Top 10 Events)' = IF([Flood Event Rank] <= 10, [Flood Deaths])
		formatString: #,0
		displayFolder: KPI\03 Human Impact
		lineageTag: b98d0a68-b689-44e3-a7e6-9dba8ed03a20

	/// Countries affected by the flood event(s) in context
	measure 'Flood Countries' = CALCULATE(CONCATENATEX(SUMMARIZE('dw fact_disaster_event', 'dw dim_location'[country_location_name]), 'dw dim_location'[country_location_name], ", ", 'dw dim_location'[country_location_name], ASC), CROSSFILTER('dw fact_disaster_event'[disaster_event_id], 'dw dim_flood'[disaster_event_id], BOTH))
		displayFolder: KPI\03 Human Impact
		lineageTag: fdbc1dab-20ce-4ac7-b6ec-ab4301c64375

	/// Earliest start date of the flood event(s) in context
	measure 'Flood Start Date' = CALCULATE(MINX('dw fact_disaster_event', RELATED('dw dim_date'[full_date])), CROSSFILTER('dw fact_disaster_event'[disaster_event_id], 'dw dim_flood'[disaster_event_id], BOTH))
		formatString: dd mmm yyyy
		displayFolder: KPI\03 Human Impact
		lineageTag: 4d9a7b35-2986-45ce-b5a9-06180394be60

	/// Share of a hazard's events that start in each month (rows sum to 100%) - for the seasonality heatmap
	measure 'Seasonality Share %' = DIVIDE([Total Events], CALCULATE([Total Events], REMOVEFILTERS('dw dim_date'[month], 'dw dim_date'[month_name])))
		formatString: 0%
		displayFolder: KPI\04 Hazard Severity
		lineageTag: b08dd98e-c4e5-4919-90da-d8ae5ec43e67

	/// Share of cyclones in category Extreme or Catastrophic
	measure 'Severe Cyclone Share %' = DIVIDE([Severe Cyclones], CALCULATE([Total Events], 'dw dim_event_type'[event_type] = "TC"))
		formatString: 0.0%
		displayFolder: KPI\04 Hazard Severity
		lineageTag: ecac0a3c-a51d-4070-b650-b204adcd5beb

	/// Earthquake events with a known magnitude
	measure 'Earthquake Events' = CALCULATE([Total Events], KEEPFILTERS(NOT ISBLANK('dw dim_earthquake'[Magnitude])))
		formatString: #,0
		displayFolder: KPI\04 Hazard Severity
		lineageTag: 1199f0be-389a-4d95-ad5a-b42a78610f05

	/// Tropical cyclone events
	measure 'Cyclone Events' = CALCULATE([Total Events], KEEPFILTERS('dw dim_event_type'[event_type] = "TC"))
		formatString: #,0
		displayFolder: KPI\04 Hazard Severity
		lineageTag: fd6e9d51-4690-4af8-8b0d-8b27de2631dc

	/// Dynamic title for the Country Profile drill-through page
	measure 'Country Profile Title' = "Country Profile — " & SELECTEDVALUE('dw dim_location'[country_location_name], "select one country")
		displayFolder: KPI\06 Country Profile
		lineageTag: 5f4350fa-0bf3-4da8-8d95-3397ab41e212

	/// Rank by Risk Score among all countries (ignores the country filter, keeps year/hazard filters)
	measure 'Global Risk Rank' = IF(HASONEVALUE('dw dim_location'[country_location_name]) && NOT ISBLANK([Risk Score]), RANKX(FILTER(ALL('dw dim_location'[country_location_name]), NOT ISBLANK([Risk Score])), [Risk Score], , DESC, Dense))
		formatString: 0
		displayFolder: KPI\06 Country Profile
		lineageTag: 5ccd6860-12f8-47a9-83dd-9cd62febb1fe

	/// e.g. '#3 of 241'
	measure 'Global Risk Rank Label' = VAR r = [Global Risk Rank] VAR n = COUNTROWS(FILTER(ALL('dw dim_location'[country_location_name]), NOT ISBLANK([Risk Score]))) RETURN IF(NOT ISBLANK(r), "#" & r & " of " & n)
		displayFolder: KPI\06 Country Profile
		lineageTag: e4606661-c930-442b-8761-fbfd7ee16067

	/// Hazard type with the most events in context
	measure 'Most Frequent Hazard' = MAXX(TOPN(1, FILTER(VALUES('dw dim_event_type'[event_type_slicer]), NOT ISBLANK([Total Events])), [Total Events], DESC, 'dw dim_event_type'[event_type_slicer], ASC), 'dw dim_event_type'[event_type_slicer])
		displayFolder: KPI\06 Country Profile
		lineageTag: 57df5094-2fed-427e-b7d1-36b7ea2c2bad

	/// Calendar month in which most events start
	measure 'Peak Month' = MAXX(TOPN(1, FILTER(SUMMARIZE(ALL('dw dim_date'), 'dw dim_date'[month], 'dw dim_date'[month_name]), NOT ISBLANK([Total Events])), [Total Events], DESC, 'dw dim_date'[month], ASC), 'dw dim_date'[month_name])
		displayFolder: KPI\06 Country Profile
		lineageTag: 16496133-12b7-493f-93ea-ef814ce1d0e4

	/// Alert weight of the event(s) in context (Red 9 / Orange 3 / Green 1) - used to sort event lists by severity
	measure 'Event Alert Weight' = MAXX(SUMMARIZE('dw fact_disaster_event', 'dw dim_alert'[alert_level]), SWITCH('dw dim_alert'[alert_level], "Red", 9, "Orange", 3, "Green", 1))
		formatString: 0
		displayFolder: KPI\06 Country Profile
		lineageTag: f6bfca44-9185-4640-b110-6ad93de2b1e2

