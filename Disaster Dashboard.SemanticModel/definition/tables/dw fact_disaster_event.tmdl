	measure RankCountry = RANKX(ALL('dw dim_location'[country_location_name]), 'dw fact_disaster_event'[DisasterRecord],,DESC,Dense)
		formatString: 0
		lineageTag: c4ffd370-5846-431d-8c25-f32f1f7f1138

		changedProperty = IsHidden

	measure '% of Disaster count' =
			DIVIDE(COUNT('dw fact_disaster_event'[disaster_event_id]),
			                        CALCULATE(
			                                    COUNT('dw fact_disaster_event'[disaster_event_id]),
			                                    ALL('dw dim_event_type'[event_type_slicer])
			                        ))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 16b574dc-823a-4263-b508-acc007a27696

	measure 'Average Severity' = AVERAGE('dw fact_disaster_event'[severity])
		formatString: 0.00
		lineageTag: e0e996cb-2f3a-4fe8-bf74-1a23a1375c76

	measure 'Average Duration (days)' = AVERAGE('dw fact_disaster_event'[duration_days])
		formatString: 0.0
		lineageTag: a32d4af0-8bbc-41d2-94a4-fdae32097b33

	measure 'Events YTD' = VAR _last = MAXX(LASTNONBLANK('dw dim_date'[full_date], [DisasterRecord]), 'dw dim_date'[full_date]) RETURN CALCULATE([DisasterRecord], FILTER(ALL('dw dim_date'), 'dw dim_date'[full_date] >= DATE(YEAR(_last),1,1) && 'dw dim_date'[full_date] <= _last))
		formatString: 0
		lineageTag: 9f495f6a-39c9-416c-ae0b-d18b40ac41bd

	measure 'Events PY YTD' = VAR _last = MAXX(LASTNONBLANK('dw dim_date'[full_date], [DisasterRecord]), 'dw dim_date'[full_date]) RETURN CALCULATE([DisasterRecord], FILTER(ALL('dw dim_date'), 'dw dim_date'[full_date] >= DATE(YEAR(_last)-1,1,1) && 'dw dim_date'[full_date] <= EDATE(_last,-12)))
		formatString: 0
		lineageTag: 2a58be51-e8a2-4f9d-903f-479e934acac8

	measure 'Events YoY %' = DIVIDE([Events YTD] - [Events PY YTD], [Events PY YTD])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 533cccb7-a60c-42e5-aa50-b9cd862f2196

	measure 'Events Rolling 12M' = VAR _last = MAXX(LASTNONBLANK('dw dim_date'[full_date], [DisasterRecord]), 'dw dim_date'[full_date]) RETURN CALCULATE([DisasterRecord], FILTER(ALL('dw dim_date'), 'dw dim_date'[full_date] > EDATE(_last,-12) && 'dw dim_date'[full_date] <= _last))
		formatString: 0
		lineageTag: 552e2d09-6913-4394-ba45-379a0a58d9fa

	measure 'Events Rolling 12M PY' = VAR _last = MAXX(LASTNONBLANK('dw dim_date'[full_date], [DisasterRecord]), 'dw dim_date'[full_date]) RETURN CALCULATE([DisasterRecord], FILTER(ALL('dw dim_date'), 'dw dim_date'[full_date] > EDATE(_last,-24) && 'dw dim_date'[full_date] <= EDATE(_last,-12)))
		formatString: 0
		lineageTag: 768aa0b3-86a1-4c35-9f29-8ef9d217d9a3

	measure 'Events Rolling 12M YoY %' = DIVIDE([Events Rolling 12M] - [Events Rolling 12M PY], [Events Rolling 12M PY])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: cce345a0-b680-410c-8b30-e6009c0b8d50

	measure 'Affected Population YTD' = VAR _last = MAXX(LASTNONBLANK('dw dim_date'[full_date], [DisasterRecord]), 'dw dim_date'[full_date]) RETURN CALCULATE(SUM('dw fact_disaster_event'[population_effected]), FILTER(ALL('dw dim_date'), 'dw dim_date'[full_date] >= DATE(YEAR(_last),1,1) && 'dw dim_date'[full_date] <= _last))
		formatString: #,0
		lineageTag: b3377b0f-1fa5-41a1-ab8f-e9cfaebe03a9

	measure 'Affected Population PY YTD' = VAR _last = MAXX(LASTNONBLANK('dw dim_date'[full_date], [DisasterRecord]), 'dw dim_date'[full_date]) RETURN CALCULATE(SUM('dw fact_disaster_event'[population_effected]), FILTER(ALL('dw dim_date'), 'dw dim_date'[full_date] >= DATE(YEAR(_last)-1,1,1) && 'dw dim_date'[full_date] <= EDATE(_last,-12)))
		formatString: #,0
		lineageTag: 0ded5fcf-2e82-48a3-88e5-0ac412c4d06a

	measure 'Affected Population YoY %' = DIVIDE([Affected Population YTD] - [Affected Population PY YTD], [Affected Population PY YTD])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 3037263d-9d7a-4935-aaa8-8340dadd826a

	measure 'Average Severity YTD' = VAR _last = MAXX(LASTNONBLANK('dw dim_date'[full_date], [DisasterRecord]), 'dw dim_date'[full_date]) RETURN CALCULATE(AVERAGE('dw fact_disaster_event'[severity]), FILTER(ALL('dw dim_date'), 'dw dim_date'[full_date] >= DATE(YEAR(_last),1,1) && 'dw dim_date'[full_date] <= _last))
		formatString: 0.00
		lineageTag: 714ce70f-9713-4644-91aa-4ec1eb64b387

	measure 'Average Severity PY YTD' = VAR _last = MAXX(LASTNONBLANK('dw dim_date'[full_date], [DisasterRecord]), 'dw dim_date'[full_date]) RETURN CALCULATE(AVERAGE('dw fact_disaster_event'[severity]), FILTER(ALL('dw dim_date'), 'dw dim_date'[full_date] >= DATE(YEAR(_last)-1,1,1) && 'dw dim_date'[full_date] <= EDATE(_last,-12)))
		formatString: 0.00
		lineageTag: 6513a178-6331-45b4-a033-42d420e336be

	measure 'Average Severity YoY %' = DIVIDE([Average Severity YTD] - [Average Severity PY YTD], [Average Severity PY YTD])
